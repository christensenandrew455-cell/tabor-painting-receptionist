# Railway sets PORT automatically.
PUBLIC_URL=https://your-railway-service.example.com

TELNYX_API_KEY=replace-with-a-real-telnyx-key
OPENAI_API_KEY=replace-with-a-real-openai-key

RECEPTIONIST_CONFIG_URL=https://ark-websites-ocm.vercel.app/api/receptionist/runtime
DEMO_PHONE_NUMBER=+17742316164

# Normally leave this unset. ARK returns a private, account-specific intake URL on each call.
# ARC_INTAKE_URL=

# Optional AI and business fallbacks.
# Cost-controlled defaults. Raise these only after measuring real calls.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_VOICE=marin
# OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
# OPENAI_TRANSCRIPTION_LANGUAGE=en
# BUSINESS_TIME_ZONE=America/New_York
# OPENAI_MAX_OUTPUT_TOKENS=800
# OPENAI_ANALYSIS_MAX_OUTPUT_TOKENS=2048
# OPENAI_CONTEXT_TOKEN_LIMIT=2500
# OPENAI_CONTEXT_RETENTION_RATIO=0.7
# OPENAI_MAX_RESPONSES_PER_CALL=40
# MAX_CALL_DURATION_SECONDS=480
# MAX_WEBSITE_KNOWLEDGE_CHARACTERS=12000

# Optional receptionist-side service-request risk checks.
# GOOGLE_MAPS_API_KEY=replace-with-a-google-maps-platform-key
# GOOGLE_MAPS_REGION_CODE=US
# RISK_LOOKUP_TIMEOUT_MS=8000
