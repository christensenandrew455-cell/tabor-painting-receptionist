# Railway supplies PORT automatically. Do not add PORT yourself.

# One of PUBLIC_URL or RAILWAY_PUBLIC_DOMAIN is required.
PUBLIC_URL=https://your-receptionist.example.com

TELNYX_API_KEY=EXAMPLE_NOT_A_REAL_TELNYX_KEY
OPENAI_API_KEY=EXAMPLE_NOT_A_REAL_OPENAI_KEY

# Optional. Keep the production default unless using an approved staging OCM.
# OCM_RUNTIME_ENDPOINT=https://ark-websites-ocm-xi.vercel.app/api/receptionist/runtime

# Do not add per-business variables here.
# The dialed Telnyx number is matched to an ARK OCM account on every call.
# ARK OCM supplies the business information, AI voice, speech speed,
# silence timing, exact client ID, intake connection, and lead destination.
